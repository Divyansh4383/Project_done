DATABASE_URL=jdbc:postgresql://localhost:5432/sprintforge
DATABASE_USERNAME=sprintforge
DATABASE_PASSWORD=sprintforge
JWT_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_TTL=P30D
CACHE_TYPE=simple
SPRING_DATA_REDIS_HOST=localhost
REDIS_HEALTH_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
# The transactional outbox stores notification intent with the business transaction.
# Workers coordinate with FOR UPDATE SKIP LOCKED; delivery uses idempotency keys,
# bounded exponential retries, and DEAD status after the configured attempts.
# Admins can replay a dead-lettered row via POST /api/v1/admin/outbox/{id}/replay.
OUTBOX_WORKER_ENABLED=true
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_INITIAL_DELAY=PT10S
OUTBOX_POLL_DELAY=PT5S
OUTBOX_RETRY_BASE=PT10S
OUTBOX_RETRY_MAXIMUM=PT15M
# Optional one-time bootstrap admin; leave disabled for normal deployments.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_NAME=SprintForge Administrator
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@sprintforge.dev
MAIL_AUTH=false
MAIL_STARTTLS=false
PORT=8080
